generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  teacher
  student
  guest
}

enum Gender {
  Male
  Female
}

enum StudentRecordStatus {
  active
  suspended
  graduated
  withdrawn
}

enum TeacherEmploymentType {
  full_time
  part_time
  contract
}

enum TeacherRecordStatus {
  active
  on_leave
  terminated
}

enum PinType {
  admission
  result
}

enum IssuedPinStatus {
  active
  used
  expired
}

enum PinOrderPaymentStatus {
  pending
  paid
  failed
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum NoticePriority {
  low
  medium
  high
  urgent
}

enum NoticeAudience {
  all
  students
  teachers
  parents
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  role             UserRole
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  phone            String?
  avatarUrl        String?   @map("avatar_url")
  isActive         Boolean   @default(true) @map("is_active")
  passwordMustChange Boolean @default(true) @map("password_must_change")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  student Student?
  teacher Teacher?
  notices Notice[]

  @@map("users")
}

model Student {
  id                  String              @id @default(cuid())
  userId              String              @unique @map("user_id")
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNumber     String              @unique @map("admission_number")
  classLevel            String              @map("class_level")
  section               String?
  dateOfBirth           DateTime            @map("date_of_birth") @db.Date
  gender                Gender
  address               String?
  parentGuardianName    String              @map("parent_guardian_name")
  parentGuardianPhone   String              @map("parent_guardian_phone")
  parentGuardianEmail   String?             @map("parent_guardian_email")
  emergencyContact      String?             @map("emergency_contact")
  bloodGroup            String?             @map("blood_group")
  medicalConditions     String?             @map("medical_conditions")
  admissionDate         DateTime            @map("admission_date") @db.Date
  status                StudentRecordStatus @default(active)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  results    Result[]
  attendance Attendance[]

  @@index([classLevel])
  @@index([admissionNumber])
  @@map("students")
}

model Teacher {
  id               String               @id @default(cuid())
  userId           String               @unique @map("user_id")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId          String               @unique @map("staff_id")
  qualification    String?
  specialization   String?
  homeroomClass    String?              @map("homeroom_class")
  dateOfJoining    DateTime             @map("date_of_joining") @db.Date
  employmentType   TeacherEmploymentType @default(full_time) @map("employment_type")
  salary           Decimal?             @db.Decimal(10, 2)
  address          String?
  emergencyContact String?              @map("emergency_contact")
  status           TeacherRecordStatus  @default(active)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  subjects TeacherSubject[]
  results  Result[]

  @@map("teachers")
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacherLinks TeacherSubject[]
  results      Result[]

  @@map("subjects")
}

model TeacherSubject {
  id         String   @id @default(cuid())
  teacherId  String   @map("teacher_id")
  subjectId  String   @map("subject_id")
  classLevel String   @map("class_level")
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([teacherId, subjectId, classLevel])
  @@index([teacherId, classLevel])
  @@map("teacher_subjects")
}

model AcademicSession {
  id          String   @id @default(cuid())
  sessionName String   @map("session_name")
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  isCurrent   Boolean  @default(false) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  terms   Term[]
  results Result[]

  @@map("academic_sessions")
}

model Term {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  termName  String   @map("term_name")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  results Result[]

  @@unique([sessionId, termName])
  @@map("terms")
}

model Result {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  subjectId String   @map("subject_id")
  sessionId String   @map("session_id")
  termId    String   @map("term_id")
  ca1       Decimal  @default(0) @db.Decimal(5, 2)
  ca2       Decimal  @default(0) @db.Decimal(5, 2)
  exam      Decimal  @db.Decimal(5, 2)
  total     Decimal  @db.Decimal(5, 2)
  grade     String?
  remark    String?
  teacherId String?  @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject           @relation(fields: [subjectId], references: [id])
  session AcademicSession   @relation(fields: [sessionId], references: [id])
  term    Term              @relation(fields: [termId], references: [id])
  teacher Teacher?          @relation(fields: [teacherId], references: [id])

  @@unique([studentId, subjectId, sessionId, termId])
  @@index([studentId, termId])
  @@map("results")
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String           @map("student_id")
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  remarks    String?
  markedById String?          @map("marked_by_id")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@unique([studentId, date])
  @@index([studentId, date])
  @@map("attendance")
}

model PinOrder {
  id                 String               @id @default(cuid())
  studentEmail       String               @map("student_email")
  pinType            PinType              @map("pin_type")
  amount             Decimal              @db.Decimal(10, 2)
  paymentMethod      String               @map("payment_method")
  paymentStatus      PinOrderPaymentStatus @default(pending) @map("payment_status")
  paymentReference   String?              @map("payment_reference")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  issuedPins IssuedPin[]

  @@map("pin_orders")
}

model IssuedPin {
  id           String          @id @default(cuid())
  pinCode      String          @unique @map("pin_code")
  pinType      PinType         @map("pin_type")
  status       IssuedPinStatus @default(active)
  expiresAt    DateTime        @map("expires_at")
  studentEmail String?         @map("student_email")
  pinOrderId   String?         @map("pin_order_id")
  pinOrder     PinOrder?       @relation(fields: [pinOrderId], references: [id])
  usedAt       DateTime?       @map("used_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([pinCode])
  @@index([status, expiresAt])
  @@map("issued_pins")
}

model AdmissionApplication {
  id               String   @id @default(cuid())
  applicationRef   String   @unique @map("application_ref")
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  dateOfBirth      DateTime @map("date_of_birth") @db.Date
  gender           String?
  classLevel       String   @map("class_level")
  previousSchool   String?  @map("previous_school")
  address          String?
  parentName       String?  @map("parent_name")
  parentPhone      String?  @map("parent_phone")
  parentEmail      String   @map("parent_email")
  parentAddress    String?  @map("parent_address")
  emergencyContact String?  @map("emergency_contact")
  relationship     String?
  bloodGroup       String?  @map("blood_group")
  medicalConditions String? @map("medical_conditions")
  allergies        String?
  admissionPin     String?  @map("admission_pin")
  status           String   @default("pending")
  documentMeta     Json?    @map("document_meta")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("admission_applications")
}

/// CMS JSON blobs keyed for homepage / site (hero, principal, about, contact, etc.)
model SiteContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_content_blocks")
}

/// Public gallery items (image URL or video URL); managed from admin CMS.
model GalleryItem {
  id           String   @id @default(cuid())
  type         String   /// "image" | "video"
  mediaUrl     String   @map("media_url")
  thumbnailUrl String?  @map("thumbnail_url")
  title        String
  caption      String?
  category     String   @default("events")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, category, sortOrder])
  @@map("gallery_items")
}

model Notice {
  id             String         @id @default(cuid())
  title          String
  content        String         @db.Text
  targetAudience NoticeAudience @default(all) @map("target_audience")
  targetClass    String?        @map("target_class")
  priority       NoticePriority @default(medium)
  isPublished    Boolean        @default(false) @map("is_published")
  publishedAt    DateTime?      @map("published_at")
  expiresAt      DateTime?      @map("expires_at")
  createdById    String         @map("created_by_id")
  createdBy      User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([isPublished, publishedAt])
  @@map("notices")
}
