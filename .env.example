# Pooled URL (Supabase Transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Direct URL for Prisma migrate/db push (port 5432, host db.<ref>.supabase.co — not the pooler host)
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require"

# Optional: long random string for signing session cookies (set in production)
# AUTH_SESSION_SECRET=

# When true, completing a PIN purchase via PUT simulates Paystack without a real gateway.
PIN_PURCHASE_DEV_COMPLETE="false"

# After DB is reachable, create admin: npm run db:admin   (or full seed: npm run db:seed)

# --- Supabase Storage (admin CMS uploads, gallery) ---
# Project URL (Dashboard → Settings → API).
SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
# Optional if you already use this for the client:
# NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
# Service role key (Dashboard → Settings → API) — server only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service_role_secret>"
# Bucket name (default if unset: media). First admin upload creates this bucket as public if it is missing.
SUPABASE_STORAGE_BUCKET="media"
#
# If auto-create fails: Storage → New bucket → same name as SUPABASE_STORAGE_BUCKET → create, then set Public for gallery URLs if needed.
